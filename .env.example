# Database Credentials Configuration
# Note: The application automatically falls back to built-in zero-configuration SQLite (plagiarism_detector.db) if MySQL is not available.
# To connect to a local or remote MySQL server, set your MySQL credentials below:

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=plagiarism_detector

# Web Server Configuration
PORT=5000
FLASK_ENV=development
